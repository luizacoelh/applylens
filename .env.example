# Copie este arquivo para .env (dev local) e configure as mesmas chaves como
# variáveis de ambiente no painel da Vercel para produção.

# ---------------------------------------------------------------------------
# Banco de dados — LOCAL (dev)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# Banco de dados — PRODUÇÃO (Turso / libSQL)
# ---------------------------------------------------------------------------
# Deixe as duas variáveis abaixo vazias/removidas em dev local.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Autenticação (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth — crie em https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — crie em https://github.com/settings/developers
# GitHub só aceita UMA callback URL por app — use apps separados para dev e
# produção (ver DEPLOY.md).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# IA — Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY="sua_chave_aqui"

# ---------------------------------------------------------------------------
# Opcional — automação futura via n8n
# ---------------------------------------------------------------------------
N8N_WEBHOOK_SECRET=""
N8N_TARGET_USER_ID=""

# ---------------------------------------------------------------------------
# Admin (bootstrap)
# ---------------------------------------------------------------------------
# Depois de logar pela primeira vez, rode:
#   node scripts/set-admin.mjs seu-email@exemplo.com
